---
import '../styles/site.css';

const REPO = 'corund207/Reticly';
const GH = `https://github.com/${REPO}`;

// Release data is baked in at build time and refreshed in the browser (see site.js).
let releases: any[] = [];
try {
  const res = await fetch(`https://api.github.com/repos/${REPO}/releases?per_page=12`, {
    headers: { 'User-Agent': 'reticly-site', Accept: 'application/vnd.github+json' },
  });
  if (res.ok) releases = await res.json();
} catch {}
releases = releases.filter((r) => !r.draft && !r.prerelease);
const latest = releases[0];
const asset = latest?.assets?.find((a: any) => a.name === 'Reticly.exe' || a.name === 'CrosshairY.exe');
let DOWNLOAD = `${GH}/releases/latest`;
if (asset?.browser_download_url) DOWNLOAD = asset.browser_download_url;
const rel = {
  version: latest ? String(latest.tag_name).replace(/^v/, '') : '1.2.0',
  size: asset ? (asset.size / 1048576).toFixed(1) + ' MB' : '2.8 MB',
  sha: asset?.digest ? String(asset.digest).replace('sha256:', '').toUpperCase() : '',
};

type G = { id: string; name: string; author: string };
let gallery: G[] = [];
try {
  const res = await fetch(`https://raw.githubusercontent.com/${REPO}/main/gallery/gallery.json`);
  if (res.ok) gallery = ((await res.json()).crosshairs ?? []).map((c: any) => ({ id: c.id, name: c.name, author: c.author ?? '' }));
} catch {}
const preview = (id: string) => `https://raw.githubusercontent.com/${REPO}/main/gallery/previews/${id}.png`;

const statement = "Pick any crosshair. Put it on the exact center pixel of any game. Then watch it follow your gun's recoil, bullet by bullet.";

const tour = [
  { img: 'designer', title: 'Designer', text: 'Layers, shapes, text and images on a zoomable pixel canvas.' },
  { img: 'loadout', title: 'Recoil loadout', text: 'Bind each gun to your weapon keys. The tracker switches with you.' },
  { img: 'browse', title: 'Browse', text: '100+ built-in designs, ready in one click.' },
  { img: 'recoil', title: 'Recoil pattern', text: 'Game, weapon, scale, fire rate and accurate shots per tracker.' },
  { img: 'keybinds', title: 'Keybinds', text: 'Keyboard, mouse or controller. Toggle, aim, fire, swap.' },
  { img: 'settings', title: 'Settings', text: 'Monitor, position, recordings, fullscreen help.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reticly: free crosshair overlay for Windows</title>
    <meta name="description" content="Reticly draws a custom crosshair over any game, including recoil crosshairs that follow your gun's spray. Free and open source for Windows 10 and 11." />
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content="Reticly: free crosshair overlay for Windows" />
    <meta property="og:description" content="Any crosshair, on the exact center pixel of every game. Recoil crosshairs that follow your gun's spray. Free and open source." />
    <meta property="og:image" content="https://reticly.vercel.app/shots/recoil.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="nav-inner">
        <a class="brand" href="#top" aria-label="Reticly home">Reticl<span>y</span></a>
        <nav aria-label="Sections">
          <a href="#recoil">Recoil</a>
          <a href="#design">Design</a>
          <a href="#features">Features</a>
          <a href="#try">Try it</a>
          <a href="#gallery">Gallery</a>
          <a href="#install">Install</a>
        </nav>
        <a class="pill pill-sm" href={DOWNLOAD} data-dl>Download</a>
      </div>
    </header>

    <main id="main">
      <!-- hero (pinned) -->
      <section class="hero scrolly" id="top" data-scrolly="hero">
        <div class="sticky">
          <div class="hero-copy">
            <h1 class="hero-title">Reticly</h1>
            <p class="hero-sub">Your crosshair. Dead center.<br />Moving with every shot.</p>
            <div class="ctas">
              <a class="pill" href={DOWNLOAD} data-dl>Download for Windows</a>
              <a class="more" href="#recoil">See it track <span aria-hidden="true">›</span></a>
            </div>
          </div>
          <svg class="hero-reticle" viewBox="-200 -200 400 400" aria-hidden="true">
            <g class="arm arm-t"><rect x="-9" y="-150" width="18" height="90" rx="2" /></g>
            <g class="arm arm-b"><rect x="-9" y="60" width="18" height="90" rx="2" /></g>
            <g class="arm arm-l"><rect x="-150" y="-9" width="90" height="18" rx="2" /></g>
            <g class="arm arm-r"><rect x="60" y="-9" width="90" height="18" rx="2" /></g>
            <rect class="dot" x="-9" y="-9" width="18" height="18" rx="2" />
          </svg>
          <p class="hero-meta">Free · Open source · Windows 10 and 11</p>
        </div>
      </section>

      <!-- statement (words light up as you scroll) -->
      <section class="statement scrolly" data-scrolly="statement">
        <div class="sticky">
          <p class="words" aria-label={statement}>
            {statement.split(' ').map((w) => <span aria-hidden="true">{w} </span>)}
          </p>
        </div>
      </section>

      <!-- recoil (scroll drives the spray) -->
      <section class="recoil scrolly" id="recoil" data-scrolly="recoil">
        <div class="sticky">
          <div class="recoil-grid">
            <div class="recoil-stage">
              <svg id="spray-svg" viewBox="0 0 600 600" aria-hidden="true"></svg>
              <div class="round" id="spray-round" aria-hidden="true"><b>0</b><span>/ 26</span></div>
            </div>
            <div class="captions">
              <div class="cap" data-cap="0"><h2>Hold to fire.</h2><p>The first bullets stay dead center, just like in game. Then the tracker starts to move.</p></div>
              <div class="cap" data-cap="1"><h2>Up, then sideways.</h2><p>It walks the Vandal's real spray, one bullet at a time, at its real fire rate. Right where your shots go.</p></div>
              <div class="cap" data-cap="2"><h2>91 weapons. 4 games.</h2><p>VALORANT, Counter-Strike 2, Rust and Apex Legends. Every gun has its own pattern.</p></div>
              <div class="cap" data-cap="3"><h2>Let go. It snaps back.</h2><p>Release fire and the tracker returns to center, ready for the next spray.</p></div>
            </div>
          </div>
        </div>
      </section>

      <!-- design (window scales up) -->
      <section class="light design" id="design">
        <div class="wrap center reveal">
          <h2 class="headline">Design anything. <span class="dim">Lines, dots, rings, text, images and animations, layer by layer.</span></h2>
        </div>
        <div class="scrolly window-scrolly" data-scrolly="window">
          <div class="sticky">
            <figure class="window">
              <img src="/shots/designer.png" width="1320" height="840" alt="The Reticly Designer: layers panel, pixel canvas and inspector" />
            </figure>
          </div>
        </div>
      </section>

      <!-- bento features -->
      <section class="light features" id="features">
        <div class="wrap">
          <h2 class="headline reveal">Everything a crosshair needs. <span class="dim">Nothing it doesn't.</span></h2>
          <div class="bento">
            <article class="tile t-wide reveal">
              <div class="tile-copy"><h3>46 recoil crosshairs.</h3><p>Plus, dot, ring, box, bracket and chevron trackers. Comet trails, heat ramps, pull guides.</p></div>
              <img src="/shots/browse.png" width="1320" height="840" alt="Browse page with built-in crosshair designs" loading="lazy" />
            </article>
            <article class="tile t-tall dark-tile reveal">
              <div class="big">1<span>px</span></div>
              <div class="tile-copy"><h3>Exact center.</h3><p>Drawn on the true center pixel of your monitor, in physical pixels.</p></div>
            </article>
            <article class="tile reveal">
              <svg class="tile-art" viewBox="0 0 120 120" aria-hidden="true"><polyline points="60,108 60,96 61,82 59,66 58,52 63,40 70,32 64,26 54,22 46,20" fill="none" stroke="#f5a524" stroke-width="2" stroke-dasharray="3 4" /><g fill="#1d1d1f"><circle cx="60" cy="108" r="3.5" /><circle cx="60" cy="96" r="3.5" /><circle cx="61" cy="82" r="3.5" /><circle cx="59" cy="66" r="3.5" /><circle cx="58" cy="52" r="3.5" /><circle cx="63" cy="40" r="3.5" /><circle cx="70" cy="32" r="3.5" /><circle cx="64" cy="26" r="3.5" /><circle cx="54" cy="22" r="3.5" /><circle cx="46" cy="20" r="3.5" /></g></svg>
              <div class="tile-copy"><h3>Pattern editor.</h3><p>Drag any gun's bullets, test the spray, add your own guns.</p></div>
            </article>
            <article class="tile reveal">
              <svg class="tile-art" viewBox="0 0 120 120" aria-hidden="true"><g stroke="#1d1d1f" stroke-width="5" stroke-linecap="round"><path d="M40 40 52 52M80 40 68 52M40 80 52 68M80 80 68 68" /></g><circle cx="60" cy="60" r="4" fill="#f5a524" /></svg>
              <div class="tile-copy"><h3>Hit markers.</h3><p>A hit marker or kill flash on your own keys, or on every shot.</p></div>
            </article>
            <article class="tile reveal">
              <svg class="tile-art" viewBox="0 0 120 120" aria-hidden="true"><rect x="22" y="30" width="76" height="60" rx="10" fill="none" stroke="#1d1d1f" stroke-width="4" /><path d="M22 46h76" stroke="#1d1d1f" stroke-width="4" /><circle cx="60" cy="70" r="9" fill="#f5a524" /></svg>
              <div class="tile-copy"><h3>A profile per game.</h3><p>Its own crosshair, keybinds and loadout, switched automatically.</p></div>
            </article>
            <article class="tile t-half dark-tile reveal">
              <div class="tile-copy"><h3>Free. Open source.</h3><p>MIT licensed. One small file. No installer, no account, and it never reads or touches the game.</p></div>
              <a class="more" href={GH}>View the source <span aria-hidden="true">›</span></a>
            </article>
            <article class="tile t-half reveal">
              <div class="tile-copy"><h3>Speaks your language.</h3><p>English, Español, Deutsch, Français and Português.</p></div>
              <div class="langs" aria-hidden="true"><span>Hello</span><span>Hola</span><span>Hallo</span><span>Bonjour</span><span>Olá</span></div>
            </article>
          </div>
        </div>
      </section>

      <!-- try it (interactive demo) -->
      <section class="try" id="try">
        <div class="wrap">
          <h2 class="headline center reveal">Try it yourself. <span class="dim">Pick a gun, then press and hold.</span></h2>
          <div class="demo reveal">
            <div class="plot" id="plot" tabindex="0" role="button" aria-pressed="false" aria-label="Hold to fire the selected weapon's spray. Hold the mouse button, a finger, or the space bar.">
              <svg id="plot-svg" viewBox="0 0 600 600" aria-hidden="true"></svg>
              <div class="plot-readout" id="plot-readout" aria-live="polite"></div>
            </div>
            <div class="demo-side">
              <div class="seg" id="games" role="group" aria-label="Game"></div>
              <div class="weapons" id="weapons" role="group" aria-label="Weapon"></div>
              <dl class="spec" id="spec"></dl>
              <p class="hint">Hold the mouse, a finger or the space bar on the plot. <svg class="tuned" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 .8 9.2 5 5 9.2.8 5z" /></svg> marks a hand-tuned pattern. Patterns are approximations.</p>
            </div>
          </div>
        </div>
      </section>

      <!-- closer look (carousel) -->
      <section class="tour">
        <div class="wrap">
          <h2 class="headline reveal">Take a closer look.</h2>
        </div>
        <div class="rail" id="rail" tabindex="0" aria-label="App screenshots">
          {tour.map((t) => (
            <figure class="slide">
              <img src={`/shots/${t.img}.png`} width="1320" height="840" alt={`Reticly ${t.title} screen`} loading="lazy" />
              <figcaption><strong>{t.title}.</strong> {t.text}</figcaption>
            </figure>
          ))}
        </div>
        <div class="wrap rail-ctl">
          <button class="round-btn" type="button" data-rail="-1" aria-label="Previous screenshot"><svg viewBox="0 0 16 16"><path d="M10 3 5 8l5 5" /></svg></button>
          <button class="round-btn" type="button" data-rail="1" aria-label="Next screenshot"><svg viewBox="0 0 16 16"><path d="m6 3 5 5-5 5" /></svg></button>
        </div>
      </section>

      <!-- numbers -->
      <section class="numbers">
        <div class="wrap nums">
          <div class="num reveal"><b data-count="91">91</b><span>spray patterns</span></div>
          <div class="num reveal"><b data-count="100" data-suffix="+">100+</b><span>built-in designs</span></div>
          <div class="num reveal"><b data-count="0">0</b><span>accounts, ever</span></div>
        </div>
      </section>

      <!-- gallery -->
      <section class="light gallery-sec" id="gallery">
        <div class="wrap">
          <h2 class="headline reveal">Shared crosshairs. <span class="dim">Starting with Jonah's own. Approved submissions from anyone land here, and in the app.</span></h2>
          <div class="gallery" id="gallery-grid">
            {gallery.map((g) => (
              <figure class="gtile">
                <div class="gimg"><img src={preview(g.id)} alt={`${g.name} crosshair`} loading="lazy" width="492" height="240" onerror="this.parentElement.classList.add('missing')" /></div>
                <figcaption><span class="gname">{g.name}</span><span class="gby">{g.author}</span></figcaption>
              </figure>
            ))}
          </div>
          {gallery.length === 0 && <p class="gstatus" id="gallery-status">Loading the gallery…</p>}
          <p class="center gal-cta reveal">In Reticly: Discover › Community gallery › <strong>Share yours</strong>. <a class="more" href={`${GH}/issues?q=label%3Agallery`}>See submissions <span aria-hidden="true">›</span></a></p>
        </div>
      </section>

      <!-- install -->
      <section class="light install" id="install">
        <div class="wrap">
          <h2 class="headline reveal">Safe to run. <span class="dim">And honest about it.</span></h2>
          <ol class="steps">
            <li class="reveal"><span class="n">1</span><h3>Download</h3><p>One file. Put it anywhere and double-click. Nothing to install.</p></li>
            <li class="reveal"><span class="n">2</span><h3>More info › Run anyway</h3><p>The app isn't code-signed yet, so Windows asks once before running a new app.</p></li>
            <li class="reveal"><span class="n">3</span><h3>Pick a crosshair</h3><p>It's on screen instantly. Shift + Alt + Z shows and hides it.</p></li>
          </ol>
          <div class="faq reveal">
            <details><summary>Why does Windows warn me?</summary><p>Windows warns about any app that isn't code-signed, and signing costs money every year. The source is public on GitHub, so you can see exactly what it does. Click More info, then Run anyway.</p></details>
            <details><summary>It's blocked with no Run anyway button.</summary><p>That's Smart App Control, which blocks every unsigned app. You can build Reticly yourself from the source: clone the repo and run <code>.\build.ps1</code>. No Visual Studio needed.</p></details>
            <details><summary>Does it touch the game?</summary><p>No. It's a click-through window drawn on top of the game. It never reads or changes game files or memory. Some games' rules don't allow crosshair overlays in competitive play, so check the game you play.</p></details>
            <details><summary>How do I check the download?</summary><p>Each release lists its SHA-256. In PowerShell, <code>Get-FileHash .\Reticly.exe</code> should match: <code class="sha" data-rel="sha">{rel.sha}</code></p></details>
            <details><summary>How does it update?</summary><p>From version 1.3 on, Reticly checks GitHub about once a day and updates itself. Your crosshairs and settings carry over.</p></details>
          </div>
        </div>
      </section>

      <!-- final call -->
      <section class="final">
        <div class="wrap center">
          <svg class="final-mark" viewBox="0 0 32 32" aria-hidden="true"><circle cx="16" cy="16" r="10" fill="none" stroke="#f5f5f7" stroke-width="2.4" /><g fill="#000"><rect x="14" y="3" width="4" height="8" /><rect x="14" y="21" width="4" height="8" /></g><g fill="#f5a524"><rect x="15" y="5" width="2" height="6" /><rect x="15" y="21" width="2" height="6" /><rect x="5" y="15" width="6" height="2" /><rect x="21" y="15" width="6" height="2" /><rect x="14.5" y="14.5" width="3" height="3" /></g></svg>
          <h2 class="final-title reveal">Get Reticly.</h2>
          <p class="final-sub reveal">Free for Windows 10 and 11.</p>
          <a class="pill pill-lg reveal" href={DOWNLOAD} data-dl>Download</a>
          <p class="final-meta">Version <span data-rel="version">{rel.version}</span> · <span data-rel="size">{rel.size}</span> · <a href={`${GH}/releases`}>All releases</a></p>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="wrap">
        <div class="foot-cols">
          <div><h4>Reticly</h4><a href="#recoil">Recoil tracking</a><a href="#design">Designer</a><a href="#features">Features</a><a href="#gallery">Gallery</a></div>
          <div><h4>Get it</h4><a href={DOWNLOAD} data-dl>Download</a><a href={`${GH}/releases`}>Release notes</a><a href="#install">Install help</a></div>
          <div><h4>Project</h4><a href={GH}>Source code</a><a href={`${GH}/blob/main/LICENSE`}>MIT license</a><a href={`${GH}/issues`}>Report a problem</a></div>
        </div>
        <p class="legal">Reticly is made by Jonah: free and open source under the MIT license. Not affiliated with any game or publisher; game names belong to their owners.</p>
      </div>
    </footer>

    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
